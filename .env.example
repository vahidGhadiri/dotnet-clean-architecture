# ==========================================
# DateApp Environment Configuration
# ==========================================
# Copy this file:
#   cp .env.example .env
#
# Do NOT commit the .env file.
# This file only contains example values.
# ==========================================


# ==========================================
# JWT Configuration
# ==========================================

# Secret key used for signing JWT tokens.
# Must be a long random string (minimum 64 characters recommended).
TOKEN_KEY=change-this-to-a-secure-random-jwt-key


# ==========================================
# MinIO Application Credentials
# ==========================================
# Credentials used by the API to communicate with MinIO.

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change-this-access-key
MINIO_SECRET_KEY=change-this-secret-key
MINIO_BUCKET_NAME=photos


# ==========================================
# MinIO Root Credentials
# ==========================================
# Used only when the MinIO container starts.
# These credentials are used to login to MinIO Console.
#
# Console:
# http://localhost:9001

MINIO_ROOT_USER=change-this-root-user
MINIO_ROOT_PASSWORD=change-this-root-password
